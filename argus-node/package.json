{
  "name": "argus-logging-node",
  "version": "1.0.0",
  "description": "Argus for Node.js — contract-enforced OpenTelemetry structured logging with PII masking, AsyncLocalStorage context propagation, and a non-blocking async transport pipeline.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "bench": "npm run build && node benchmarks/throughput.js",
    "example:web": "npm run build && node examples/web-server.js",
    "example:micro": "npm run build && node examples/microservice.js",
    "example:errors": "npm run build && node examples/error-handling.js"
  },
  "keywords": [
    "logging",
    "opentelemetry",
    "otel",
    "structured-logging",
    "pii",
    "masking",
    "async-local-storage",
    "worker-threads"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
